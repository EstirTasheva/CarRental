@{
	ViewData["Title"] = "Начало";
}

<div class="home-bg mb-4">
	<div class="home-box">
		<div class="text-center mb-2">
			<img src="/images/RentACarLogo.png" alt="Розов свят" class="home-logo mb-3" />
			<h1 class="fw-bold pink-title mb-1">Наем на автомобили „Розов свят“</h1>
			<p class="home-subtitle mb-3">
				Бърза резервация • Ясни цени • Поддържани автомобили
			</p>
			<a asp-controller="Cars" asp-action="Index" class="btn btn-lg btn-pink mt-4">
				Разгледай автомобили
			</a>
		</div>
	</div>
</div>

<div class="row g-3 mb-4">
	<div class="col-md-4">
		<div class="info-box">
			<div class="info-top">50+</div>
			<div class="text-muted mt-2">автомобила в автопарка</div>
		</div>
	</div>
	<div class="col-md-4">
		<div class="info-box">
			<div class="info-top">24/7</div>
			<div class="text-muted mt-2">поддръжка и съдействие</div>
		</div>
	</div>
	<div class="col-md-4">
		<div class="info-box">
			<div class="info-top">5 мин</div>
			<div class="text-muted mt-2">бърза онлайн резервация</div>
		</div>
	</div>
</div>

<div class="row g-3">
	<div class="col-md-4">
		<div class="info-box2">
			<h5 class="info-top">Ясни цени</h5>
			<p class="text-muted mt-2">Без скрити такси – виждаш тарифата още преди наема.</p>
		</div>
	</div>
	<div class="col-md-4">
		<div class="info-box2">
			<h5 class="info-top">Поддържани автомобили</h5>
			<p class="text-muted mt-2">Всеки автомобил е в отлично състояние.</p>
		</div>
	</div>
	<div class="col-md-4">
		<div class="info-box2">
			<h5 class="info-top">Бърза процедура</h5>
			<p class="text-muted mt-2">Лесно наемане – избираш кола, период и потвърждаваш.</p>
		</div>
	</div>

	<div class="col-md-12 mt-4">
		<div class="info-box">
			<div class="container py-3">
				<div class="text-center mb-5">
					<h2 class="pink-title">Как работи?</h2>
				</div>

				<div class="row text-center g-4">
					<div class="col-md-4">
						<div class="simple-step">
							<div class="step-number">1</div>
							<h5 class="pink-title">Избери автомобил</h5>
							<p class="text-muted mt-3">Разгледай наличните автомобили и избери този, който ти подхожда.</p>
						</div>
					</div>

					<div class="col-md-4">
						<div class="simple-step">
							<div class="step-number">2</div>
							<h5 class="pink-title">Избери период</h5>
							<p class="text-muted mt-3">Посочи начална и крайна дата за наема на автомобила.</p>
						</div>
					</div>

					<div class="col-md-4">
						<div class="simple-step">
							<div class="step-number">3</div>
							<h5 class="pink-title">Направи резервация</h5>
							<p class="text-muted mt-3">Завърши заявката бързо и лесно само с няколко клика.</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="col-md-12 mt-4">
		<div class="info-box2">
			<div class="container py-3">
				<div class="text-center mb-5">
					<h2 class="pink-title">Често задавани въпроси</h2>
				</div>

				<div class="row g-4 align-items-center">
					<div class="col-md-4 text-center">
						<img src="~/images/keys.png" class="faq-img" />
					</div>

					<div class="col-md-8">
						<div>
							<div class="faq-box">
								<h5 class="pink-title">Как мога да направя резервация?</h5>
								<p class="text-muted">Избираш автомобил, посочваш периода и изпращаш заявката онлайн.</p>
							</div>

							<div class="faq-box">
								<h5 class="pink-title">Мога ли да видя цената предварително?</h5>
								<p class="text-muted">Да, ценовите тарифи са видими в системата преди потвърждение.</p>
							</div>

							<div class="faq-box">
								<h5 class="pink-title">Колко време отнема резервацията?</h5>
								<p class="text-muted">Само няколко минути, ако вече си избрал подходящ автомобил.</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>